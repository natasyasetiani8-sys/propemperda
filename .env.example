# Salin menjadi .env lalu sesuaikan. Semua opsional.
PORT=3000
HOST=0.0.0.0

# Hanya dipakai saat akun admin pertama kali dibuat (jika kosong, kata sandi acak dicetak di terminal)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Batas ukuran unggahan (MB)
MAX_UPLOAD_MB=25

# Aktifkan jika situs diakses lewat HTTPS / di belakang Nginx
COOKIE_SECURE=0
TRUST_PROXY=0

# Isi jika halaman publik di-host di domain lain (mis. https://dprd.nttprov.go.id)
CORS_ORIGIN=
